@startuml
class ActivePiece {
    + Shape : IShape
    + Position : Vector2Int
    + RotationIndex : int
    + CurrentState : ShapeState
}
class Board {
    - _grid : bool[,]
}
class BoardRenderer {
}
class Config {
}
class Controller {
    - _bag : RandomBag<Shape>
    - _gravityAccumulator : float
    - _isGrounded : bool
    - _lockAccumulator : float
    + Level : int
}
class EventBus {
    + OnPieceMoved : UnityEvent<Vector2Int>
    + OnPieceRotated : UnityEvent<int>
    + OnHardDrop : UnityEvent
    + OnPieceSpawned : UnityEvent<ActivePiece>
    + OnPieceLocked : UnityEvent<Board>
    + OnBoardChanged : UnityEvent<Board>
    + OnGameOver : UnityEvent
    + Config : IConfig
}
interface IConfig {
}
class InputAdapter {
    - _dasTimer : float
    - _heldDirection : Vector2Int
}
interface IShape {
}
class Rules {
}
class Shape {
    + Tile : Tile
    + ShapeStates : ShapeState[]
}
class ShapeState {
    + Cells : Vector2Int[]
    + CW : Vector2Int[]
    + CCW : Vector2Int[]
}
MonoBehaviour <|-- BoardRenderer
IConfig <|-- Config
MonoBehaviour <|-- Controller
MonoBehaviour <|-- EventBus
MonoBehaviour <|-- InputAdapter
ScriptableObject <|-- Shape
IShape <|.. Shape
ActivePiece --> IShape : Shape
ActivePiece --> ShapeState : CurrentState
EventBus --> IConfig : Config
@enduml
